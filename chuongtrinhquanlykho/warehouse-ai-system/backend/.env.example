# ============================================================
# .env.example — Mẫu biến môi trường cho backend
# ============================================================
# CÁCH DÙNG:
#   1. Copy file này thành .env  (cp .env.example .env)
#   2. Điền giá trị thật vào .env
#   3. KHÔNG commit .env lên Git — chỉ commit .env.example này
# ============================================================

# --- Database ---
# SQLite (dùng khi dev/demo): sqlite:///./warehouse.db
# PostgreSQL (khi triển khai thật): postgresql://user:password@host:5432/warehouse
DATABASE_URL=sqlite:///./warehouse.db

# --- AI Engine ---
# Chọn AI provider: gemini | openai | claude | ollama
AI_PROVIDER=gemini

# API key của Gemini (lấy tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model sử dụng — kiểm tra model mới nhất tại thời điểm triển khai
# Hiện tại đề xuất: gemini-1.5-flash (nhanh, chi phí thấp)
AI_MODEL=gemini-1.5-flash

# --- App Security ---
# Khóa bí mật để ký JWT — THAY BẰNG CHUỖI NGẪU NHIÊN DÀI KHI TRIỂN KHAI
# Tạo nhanh: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string

# Thời gian sống của JWT (phút) — mặc định 60 phút
JWT_EXPIRE_MINUTES=60

# --- App Config ---
# Môi trường chạy: development | production
FLASK_ENV=development

# Port backend (mặc định Flask: 5000)
FLASK_PORT=5000

# --- (Tùy chọn) OpenAI / Claude nếu đổi AI_PROVIDER ---
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_claude_api_key_here
